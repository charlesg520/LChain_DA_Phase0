# HQ edge proxy. Set HQ_DOMAIN in .env to a real domain pointed at the VPS and
# Caddy gets a Let's Encrypt certificate automatically. With the default
# "localhost" it serves a locally-trusted certificate for testing.

{$HQ_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Web console routes. Caddy tries `handle` blocks with the most specific
	# path first, so these win over the /api/* catch-all below.
	handle /ws {
		reverse_proxy web:3000
	}
	handle /api/history* {
		reverse_proxy web:3000
	}
	handle /api/skills* {
		reverse_proxy web:3000
	}
	handle /api/skill-proposals* {
		reverse_proxy web:3000
	}
	handle /api/sandboxes* {
		reverse_proxy web:3000
	}
	handle /api/notify* {
		reverse_proxy web:3000
	}

	# Agent Protocol + ops API, for scripts and curl. Bearer-token auth is
	# enforced by the agent itself.
	handle /api/* {
		uri strip_prefix /api

		# Don't publish the API schema (Aegra serves it without auth).
		@apidocs path /docs* /redoc* /openapi.json
		respond @apidocs 404

		reverse_proxy agent:8000 {
			flush_interval -1 # stream SSE tokens immediately
			transport http {
				read_timeout 0 # long-running agent runs
			}
		}
	}

	# Everything else is the web UI (static files, served by the console).
	handle {
		reverse_proxy web:3000
	}
}
