# Read ONLY by the git-gateway container. `make init` copies this to git-gateway.env.
# Never commit git-gateway.env.

# A GitHub fine-grained personal access token:
#   github.com -> Settings -> Developer settings -> Fine-grained tokens
#   Repository access: "Only select repositories" (the ones HQ may work on)
#   Permissions: Contents = Read and write, Metadata = Read (added automatically)
GIT_GATEWAY_GITHUB_TOKEN=

# Repos the agent may push to and read privately: owner/repo, comma-separated, globs allowed.
# Public repos outside this list can still be cloned (anonymously); they just can't be pushed.
GIT_GATEWAY_ALLOWED_REPOS=charlesg520/*

# Pushes are accepted only for branches under this prefix. main is never pushable.
GIT_GATEWAY_PUSH_PREFIX=hq/
