# Copy to .env (`make init` does this and fills in secrets). Never commit .env.

# --- Owner access ---------------------------------------------------------
# Bearer token for the API. `make init` generates one (48+ random chars).
HQ_API_TOKEN=
# Public hostname for Caddy/HTTPS (point a DNS A record at the VPS). "localhost" for local testing.
HQ_DOMAIN=localhost
# Host user/group the agent container runs as (owner of this repo). `make init` sets these.
HQ_UID=
HQ_GID=

# --- Models (provider:model) ----------------------------------------------
ANTHROPIC_API_KEY=
MODEL_ORCHESTRATOR=anthropic:claude-sonnet-5
MODEL_CODER=anthropic:claude-sonnet-5
MODEL_REVIEWER=anthropic:claude-opus-5-5
# Local models run on your home machine via Ollama over Tailscale. If OLLAMA_BASE_URL
# is empty or the machine is asleep, the role falls back to MODEL_FALLBACK.
MODEL_RESEARCHER=ollama:qwen3:14b
MODEL_FALLBACK=anthropic:claude-haiku-4-5-20251001
OLLAMA_BASE_URL=

# --- Sandboxes ------------------------------------------------------------
# Tried in order. Add your home node first once it's set up (see infra/home-node).
SANDBOX_DOCKER_HOSTS=tcp://docker-proxy:2375
SANDBOX_IMAGE=hq-sandbox:latest
SANDBOX_MEM=1536m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=512
SANDBOX_TIMEOUT=300

# Idle reaper: stop sandboxes nobody has used for a while, remove long-stopped ones.
# /workspace volumes are never touched. A running command always counts as activity.
SANDBOX_REAPER_ENABLED=true
SANDBOX_IDLE_STOP_MINUTES=30
SANDBOX_IDLE_REMOVE_HOURS=24
SANDBOX_REAPER_INTERVAL_SECONDS=120
# Per-host overrides in minutes, e.g. keep home-machine sandboxes longer:
# SANDBOX_IDLE_STOP_OVERRIDES=tcp://100.x.y.z:2375=180
SANDBOX_IDLE_STOP_OVERRIDES=

# --- Git ------------------------------------------------------------------
# Sandboxes reach GitHub through the git-gateway container. The GitHub token and
# the repo allowlist live in secrets/git-gateway.env (only the gateway reads it).
# Shared secret between sandboxes and the gateway. `make init` generates it.
GIT_GATEWAY_SECRET=
# Home-machine sandboxes can't resolve "git-gateway"; point them at the VPS over
# Tailscale and set GIT_GATEWAY_BIND to the VPS's Tailscale IP:
# GIT_GATEWAY_URL_OVERRIDES=tcp://100.x.y.z:2375=http://100.a.b.c:8081
GIT_GATEWAY_URL_OVERRIDES=
GIT_GATEWAY_BIND=127.0.0.1
# How the agent's commits are signed. Use your GitHub noreply address to link them.
HQ_GIT_AUTHOR_NAME=HQ Agent
HQ_GIT_AUTHOR_EMAIL=hq-agent@users.noreply.local

# --- MCP tools (config/mcp.json) ------------------------------------------
# GitHub's remote MCP server: issues, PRs, code search. A fine-grained token with
# read access plus "Pull requests: read/write" is enough. Leave empty to skip it.
GITHUB_MCP_TOKEN=

# --- Behavior -------------------------------------------------------------
ENABLE_TODOS=false
# Skill changes go through propose_skill -> your review. false = auto-approve (still versioned).
REQUIRE_SKILL_APPROVAL=true
# Remind agents once to push before finishing when they leave unpushed commits.
PUSH_BEFORE_DONE=true

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=hq
POSTGRES_PASSWORD=
POSTGRES_DB=hq
SQLALCHEMY_POOL_SIZE=2
SQLALCHEMY_MAX_OVERFLOW=0
LANGGRAPH_MIN_POOL_SIZE=1
LANGGRAPH_MAX_POOL_SIZE=6

# --- Search ---------------------------------------------------------------
SEARXNG_SECRET=

# --- Observability (enable with `make up PROFILES=obs`) --------------------
OTEL_SERVICE_NAME=hq-agent
OTEL_TARGETS=
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
