# Copy to .env (`make init` does this and fills in secrets). Never commit .env.

# --- Owner access ---------------------------------------------------------
# Bearer token for the API. `make init` generates one (48+ random chars).
HQ_API_TOKEN=
# Public hostname for Caddy/HTTPS (point a DNS A record at the VPS). "localhost" for local testing.
HQ_DOMAIN=localhost
# Host user/group the agent container runs as (owner of this repo). `make init` sets these.
HQ_UID=
HQ_GID=

# --- Models (provider:model) ----------------------------------------------
ANTHROPIC_API_KEY=
MODEL_ORCHESTRATOR=anthropic:claude-sonnet-5
MODEL_CODER=anthropic:claude-sonnet-5
MODEL_REVIEWER=anthropic:claude-opus-5-5
# Local models run on your home machine via Ollama over Tailscale. If OLLAMA_BASE_URL
# is empty or the machine is asleep, the role falls back to MODEL_FALLBACK.
MODEL_RESEARCHER=ollama:qwen3:14b
MODEL_FALLBACK=anthropic:claude-haiku-4-5-20251001
OLLAMA_BASE_URL=

# --- Sandboxes ------------------------------------------------------------
# Tried in order. Add your home node first once it's set up (see infra/home-node).
SANDBOX_DOCKER_HOSTS=tcp://docker-proxy:2375
SANDBOX_IMAGE=hq-sandbox:latest
SANDBOX_MEM=1536m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=512
SANDBOX_TIMEOUT=300

# --- Behavior -------------------------------------------------------------
ENABLE_TODOS=false
REQUIRE_SKILL_APPROVAL=true

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=hq
POSTGRES_PASSWORD=
POSTGRES_DB=hq
SQLALCHEMY_POOL_SIZE=2
SQLALCHEMY_MAX_OVERFLOW=0
LANGGRAPH_MIN_POOL_SIZE=1
LANGGRAPH_MAX_POOL_SIZE=6

# --- Search ---------------------------------------------------------------
SEARXNG_SECRET=

# --- Observability (enable with `make up PROFILES=obs`) --------------------
OTEL_SERVICE_NAME=hq-agent
OTEL_TARGETS=
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
